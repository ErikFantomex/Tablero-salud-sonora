# ============================================================
# Jupyter
# ============================================================

.ipynb_checkpoints/

# ============================================================
# Project data
# ============================================================

# Raw downloaded data should never be committed
data/raw/*
!data/raw/.gitkeep

# Intermediate generated datasets
data/interim/*
!data/interim/.gitkeep

# Final processed datasets
data/processed/*
!data/processed/.gitkeep

# Red de seguridad: ningún dato o caché generado se versiona
data/**
!data/.gitkeep
*.parquet

# ============================================================
# IDE / OS
# ============================================================

.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================================
# Figuras generadas
# ============================================================

# Los HTML interactivos del notebook pueden llevar la llave de CARTO en el mapa
# base y se regeneran al ejecutarlo; solo se versionan los PNG.
reports/figures/*.html
# Entorno local de Python. Vive dentro del proyecto porque el entorno de
# desarrollo no permite escribir en /opt/homebrew ni en ~/.local.
.tools/

# Caché
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.streamlit/secrets.toml

# macOS
.DS_Store
